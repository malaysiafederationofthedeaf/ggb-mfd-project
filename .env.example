# Environment configuration template
# Copy this file to .env.local and fill in the actual values

# Strapi CMS base URL
REACT_APP_STRAPI_BASE_URL=<YOUR_STRAPI_BASE_URL>

# Cloudflare R2 Base URL for assets
REACT_APP_R2_BASE_URL=<YOUR_CLOUDFLARE_R2_BASE_URL>

# Google Analytics Tracking ID
REACT_APP_GAID=<YOUR_GA_TRACKING_ID>

# "Coming Soon" fallback image URL
REACT_APP_COMING_SOON_IMAGE_URL=<YOUR_COMING_SOON_IMAGE_URL>

# ---------------------------------------------------------------------------
# YouTube API credentials — DO NOT set these as REACT_APP_ variables.
# They must be set as SERVER-SIDE environment variables in the
# Cloudflare Pages dashboard (Settings → Environment Variables).
# They are used exclusively by functions/api/youtube-playlist.js.
#
# Required Cloudflare Pages env vars (not in .env.local):
#   YOUTUBE_API_KEY       — your YouTube Data API v3 key
#   YOUTUBE_PLAYLIST_ID   — the featured videos playlist ID
# ---------------------------------------------------------------------------